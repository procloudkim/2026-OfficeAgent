#!/bin/sh

# Retrobot post-commit hook
# Codex를 읽기 전용으로 실행하고, 최종 Markdown만 retros/에 저장합니다.

LAST_MSG=$(git log -1 --pretty=%s 2>/dev/null)
case "$LAST_MSG" in
    "docs(retro): 자동 회고 생성 by Retrobot") exit 0 ;;
esac

SKILL_PATH="retrobot/SKILL.md"
WORKLOG_PATH="retros/WORKLOG.md"

if [ ! -f "$SKILL_PATH" ] || [ "${RETROBOT_SKIP:-0}" = "1" ]; then
    exit 0
fi

if ! command -v codex >/dev/null 2>&1; then
    echo "ℹ Retrobot: codex CLI를 찾지 못해 회고 생성을 건너뜁니다."
    exit 0
fi

STAMP=$(TZ=Asia/Seoul date "+%Y-%m-%d_%H%M%S")
RETRO_PATH="retros/${STAMP}_retro.md"
TEMP_PATH="${RETRO_PATH}.tmp"
TIMELINE_PATH="retros/TIMELINE.md"
GIT_DIR=$(git rev-parse --git-dir)
ERROR_LOG="${GIT_DIR}/retrobot-last.log"

mkdir -p retros
echo "🤖 Retrobot: 회고 생성 중..."

{
    cat "$SKILL_PATH"
    printf "\n\n## 이번 실행 입력\n\n"
    printf "### 최신 커밋\n\n"
    git show -1 --format=fuller --stat --name-status --no-renames
    if [ -f "$WORKLOG_PATH" ]; then
        printf "\n\n### 지원자 작업 로그\n\n"
        cat "$WORKLOG_PATH"
    fi
} | codex exec \
    --ephemeral \
    --sandbox read-only \
    --skip-git-repo-check \
    -c 'approval_policy="never"' \
    - >"$TEMP_PATH" 2>"$ERROR_LOG"
CODEX_STATUS=$?

if [ "$CODEX_STATUS" -ne 0 ] || [ ! -s "$TEMP_PATH" ]; then
    rm -f "$TEMP_PATH"
    echo "ℹ Retrobot: 생성 실패(exit ${CODEX_STATUS}). ${ERROR_LOG}를 확인하세요."
    exit 0
fi

mv "$TEMP_PATH" "$RETRO_PATH"

if [ ! -f "$TIMELINE_PATH" ]; then
    {
        printf "# Retrobot 타임라인\n\n"
        printf "| 시각 (KST) | 회고 | 기준 커밋 |\n"
        printf "|---|---|---|\n"
    } >"$TIMELINE_PATH"
fi

SUBJECT=$(git log -1 --pretty=%s | tr '|' '/')
printf "| %s | [%s](./%s) | %s |\n" \
    "$STAMP" \
    "$(basename "$RETRO_PATH")" \
    "$(basename "$RETRO_PATH")" \
    "$SUBJECT" >>"$TIMELINE_PATH"

git add retros/
git commit -m "docs(retro): 자동 회고 생성 by Retrobot" --no-verify
echo "✅ Retrobot: ${RETRO_PATH} 생성 및 커밋 완료"
