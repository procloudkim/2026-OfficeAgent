FROM ghcr.io/astral-sh/uv:0.11.32-python3.12-trixie-slim@sha256:8f1995ceab97517a621cbdd9c795bba9e8119cf6c472e2b9983bc7a70ac5e3e0

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY README.md ./
COPY src ./src
COPY .githooks ./.githooks

# The lockfile, not an unconstrained resolver, defines the test environment.
RUN uv sync --frozen --group dev

# The test image must not inherit the host's Codex CLI or Node runtime. This
# build-time check complements the in-container pytest assertion.
RUN ! command -v node >/dev/null 2>&1 \
    && ! command -v codex >/dev/null 2>&1 \
    && test ! -e /root/.codex

COPY tests ./tests
COPY Dockerfile.test .dockerignore ./
COPY retrobot/SKILL.md ./retrobot/
COPY retros/WORKLOG.md ./retros/
COPY scripts/__init__.py scripts/live_smoke.py scripts/live_smoke_contract.py scripts/retrobot_context.py scripts/retrobot_guard.py scripts/retrobot_publish.py scripts/validate_documentation.py ./scripts/

ENV PATH="/app/.venv/bin:${PATH}"
